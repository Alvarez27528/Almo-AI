rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Reject absurdly large documents and unexpected top-level shapes
    function validUserDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly([
        'userProfile', 'transactions', 'goals', 'budgets', 'challenges', 'investments',
        'vintedListings', 'calendarEvents', 'chatHistory', 'financialPlans', 'userXP',
        'userLevel', 'badges', 'theme', 'userRank', 'aiTokensUsed', 'savedChats',
        'premiumExpiresAt', 'challengesCompletedToday', 'plan', 'rank'
      ])
      && (!('transactions' in d) || d.transactions.size() <= 5000)
      && (!('chatHistory' in d) || d.chatHistory.size() <= 1000);
    }

    // Each user can only touch their own document
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validUserDoc();
    }
  }
}
